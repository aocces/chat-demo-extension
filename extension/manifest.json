{
  "manifest_version": 3,
  "name": "DeepSeek Chat",
  "version": "0.1.5",
  "description": "把 DeepSeek chat-demo 装进浏览器侧边栏：纯前端直连 API，无后端；支持框选截屏发图。",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "contextMenus", "tabs", "scripting", "activeTab"],
  "host_permissions": ["https://api.deepseek.com/*", "<all_urls>"],
  "action": {
    "default_title": "打开 DeepSeek Chat 侧边栏",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["floater.js", "capture.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "打开 DeepSeek 侧边栏"
    },
    "capture-region": {
      "suggested_key": { "default": "Ctrl+Shift+X" },
      "description": "框选截屏并发送给 DeepSeek"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
